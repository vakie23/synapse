# API service
PORT=4000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Optional: same long random value on API and Admin for reliable cross-domain admin actions (recommended on Render)
ADMIN_API_KEY=
ADMIN_SESSION_SECRET=change-this-in-production
CORS_ORIGINS=https://your-web-domain.example,https://your-admin-domain.example

# Web/Admin services
API_BASE_URL=https://your-api-domain.example

# Mobile Android app (Google Play build)
APP_URL=https://your-app-domain.example
API_URL=https://your-api-domain.example

# Optional: Google Play listing URL (shows on /get-app page)
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.synapseengineering.hardwaresupplies
