{
  "name": "@hardware/mobile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "echo \"Synapse Android app loads the deployed customer app. Run: npm run app:prepare from repo root\"",
    "build": "node -e \"console.log('Skipping mobile build on Render/CI. Run npm run app:prepare locally for Android.')\"",
    "android:prepare": "node scripts/prepare-android.mjs",
    "android:release": "node scripts/build-release.mjs",
    "android:init": "cap add android",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:bundle": "cd android && gradlew.bat bundleRelease",
    "lint": "echo \"No lint configured for mobile\""
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1"
  }
}
