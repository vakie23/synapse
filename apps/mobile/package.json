{
  "name": "@hardware/mobile",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "echo \"Mobile app loads the deployed website. Run: npm run android:prepare\"",
    "build": "node scripts/prepare-android.mjs",
    "android:prepare": "node scripts/prepare-android.mjs",
    "android:init": "cap add android",
    "android:sync": "cap sync android",
    "android:open": "cap open android",
    "android:bundle": "cd android && gradlew.bat bundleRelease",
    "lint": "echo \"No lint configured for mobile\""
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1"
  }
}
